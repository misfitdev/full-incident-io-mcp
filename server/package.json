{
  "name": "incident-api-mcp",
  "version": "1.0.0",
  "description": "MCP Server generated from OpenAPI spec for incident-api-mcp",
  "private": true,
  "type": "module",
  "main": "build/index.js",
  "files": [
    "build",
    "src"
  ],
  "scripts": {
    "start": "node build/index.js",
    "build": "tsc && shx chmod 755 build/index.js",
    "typecheck": "tsc --noEmit",
    "prestart": "npm run build",
    "test": "tsc -p tsconfig.test.json && node --test \"build-test/**/*.test.js\"",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.0",
    "axios": "^1.9.0",
    "dotenv": "^16.4.5",
    "zod": "^3.24.3",
    "json-schema-to-zod": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.2",
    "typescript": "^5.8.3",
    "shx": "^0.4.0",
    "eslint": "^10.5.0",
    "@eslint/js": "^10.0.1",
    "typescript-eslint": "^8.61.1"
  }
}
